/* ============================================
   编辑器视图样式 - Notepad++ 风格
   ============================================ */

ScintillaEditView {
    background-color: #FFFFFF;
    color: #000000;
    selection-background-color: #ADD6FF;
    selection-color: #000000;
    border: none;
    outline: none;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10pt;
}

/* 当前行高亮 */
ScintillaEditView:focus {
    border: none;
    outline: none;
}